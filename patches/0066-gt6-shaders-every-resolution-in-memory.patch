+/* [GT6 0112] THE SHADER CACHE IN MEMORY (2026-11-24: shaders read in ahead, all of them, at the speed of a
+ * PC's SSD - a track loading like other PC games', not a PS3's). Test sh2 (a warm cache, 2560x1440): in the race's
+ * first frames about a thousand shaders were asked for, each read from its own file by a compile worker while its
+ * draw was left out - 3,274 draws left out over the race. Now, while the game boots, one thread reads every file of
+ * the disk cache into memory (an eighth of the PC's memory at most) and publishes the table once; from then on a
+ * shader whose file is there is taken from memory on the renderer at once (ld_ap_request) - its draw is made in the
+ * same frame. A shader that is not there goes to the workers as before. LD_SHADER_MEMORY=0 = off. */
+typedef struct ld_mc_entry {
+    struct ld_mc_entry* next;
+    u64 hash;
+    u32 length, blob_length, reserved;
+    char stage;
+    const u8* source;                  /* the file's source text, then its blob */
+} ld_mc_entry;
+#define LD_MC_BUCKETS 65536u
+static ld_mc_entry* g_ld_mc_bucket[LD_MC_BUCKETS];
+static volatile LONG g_ld_mc_ready;
+static u32 g_ld_mc_files, g_ld_mc_taken;
+static u64 g_ld_mc_bytes;
+static DWORD WINAPI ld_mc_thread(LPVOID unused)
+{
+    (void)unused;
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    const ULONGLONG t0 = GetTickCount64();
+    MEMORYSTATUSEX ms; ms.dwLength = sizeof ms;
+    u64 budget = 1536ull << 20;
+    if (GlobalMemoryStatusEx(&ms) && ms.ullTotalPhys / 8u > budget) budget = ms.ullTotalPhys / 8u;
+    char pattern[MAX_PATH];
+    if (snprintf(pattern, sizeof pattern, "%s\\*.bin", g_ld_shader_disk_dir) >= (int)sizeof pattern) return 0;
+    WIN32_FIND_DATAA fd;
+    HANDLE find = FindFirstFileA(pattern, &fd);
+    u32 skipped = 0;
+    if (find != INVALID_HANDLE_VALUE) {
+        do {
+            if (fd.dwFileAttributes & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT)) continue;
+            const char st = fd.cFileName[0];
+            unsigned long long hash = 0; unsigned len = 0;
+            if ((st != 'P' && st != 'V') || sscanf(fd.cFileName + 1, "_%16llX_%8X.bin", &hash, &len) != 2) { skipped++; continue; }
+            const u64 size = ((u64)fd.nFileSizeHigh << 32) | fd.nFileSizeLow;
+            if (size < sizeof(shader_disk_cache_header) || size > (8u << 20) || g_ld_mc_bytes + size > budget) { skipped++; continue; }
+            char path[MAX_PATH];
+            if (snprintf(path, sizeof path, "%s\\%s", g_ld_shader_disk_dir, fd.cFileName) >= (int)sizeof path) continue;
+            HANDLE h = CreateFileA(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, FILE_FLAG_SEQUENTIAL_SCAN, NULL);
+            if (h == INVALID_HANDLE_VALUE) { skipped++; continue; }
+            u8* data = (u8*)malloc((size_t)size + sizeof(ld_mc_entry));
+            DWORD got = 0;
+            const BOOL ok = data && ReadFile(h, data + sizeof(ld_mc_entry), (DWORD)size, &got, NULL) && got == (DWORD)size;
+            CloseHandle(h);
+            if (!ok) { free(data); skipped++; continue; }
+            shader_disk_cache_header hd;
+            memcpy(&hd, data + sizeof(ld_mc_entry), sizeof hd);
+            if (hd.magic != SHADER_DISK_CACHE_MAGIC || hd.version != SHADER_DISK_CACHE_VERSION || hd.stage != (u32)st ||
+                hd.source_hash != hash || hd.source_length != len || !hd.blob_length || hd.blob_length > SHADER_DISK_CACHE_MAX_BLOB ||
+                sizeof hd + (u64)hd.source_length + hd.blob_length > size) { free(data); skipped++; continue; }
+            ld_mc_entry* e = (ld_mc_entry*)data;
+            e->hash = hash; e->length = len; e->blob_length = hd.blob_length; e->reserved = hd.reserved; e->stage = st;
+            e->source = data + sizeof(ld_mc_entry) + sizeof hd;
+            const u32 b = (u32)(hash ^ (hash >> 32) ^ (u32)st) & (LD_MC_BUCKETS - 1u);
+            e->next = g_ld_mc_bucket[b]; g_ld_mc_bucket[b] = e;
+            g_ld_mc_files++; g_ld_mc_bytes += size;
+        } while (FindNextFileA(find, &fd));
+        FindClose(find);
+    }
+    MemoryBarrier();
+    InterlockedExchange(&g_ld_mc_ready, 1);
+    fprintf(stderr, "[shader-memory] %u shaders (%.0f MB) of the disk cache in memory in %llu ms (%u files left out); budget %.0f MB\n",
+            g_ld_mc_files, (double)g_ld_mc_bytes / 1048576.0, (unsigned long long)(GetTickCount64() - t0), skipped,
+            (double)budget / 1048576.0);
+    return 0;
+}
+static void ld_mc_start(void)
+{
+    const char* e = getenv("LD_SHADER_MEMORY");
+    if (e && *e == '0') return;
+    static int started;
+    if (started) return;
+    started = 1;
+    HANDLE t = CreateThread(NULL, 0, ld_mc_thread, NULL, 0, NULL);
+    if (t) CloseHandle(t);
+}
+/* a shader's blob from memory: its source must be the very text (the file's, as ld_scj_disk_load checks it) */
+static ID3DBlob* ld_mc_take(char stage, const char* source, u32 length, u64 hash, u32 vs_flags)
+{
+    if (!InterlockedCompareExchange(&g_ld_mc_ready, 0, 0)) return NULL;
+    const u32 b = (u32)(hash ^ (hash >> 32) ^ (u32)stage) & (LD_MC_BUCKETS - 1u);
+    for (const ld_mc_entry* e = g_ld_mc_bucket[b]; e; e = e->next) {
+        if (e->stage != stage || e->hash != hash || e->length != length) continue;
+        if (stage == 'V' && e->reserved && e->reserved != vs_flags) continue;
+        if (memcmp(e->source, source, length)) continue;
+        ID3DBlob* blob = NULL;
+        if (FAILED(D3DCreateBlob(e->blob_length, &blob)) || !blob) return NULL;
+        memcpy(blob->lpVtbl->GetBufferPointer(blob), e->source + e->length, e->blob_length);
+        g_ld_mc_taken++;
+        return blob;
+    }
+    return NULL;
+}
