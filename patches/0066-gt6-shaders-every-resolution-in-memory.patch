+/*
+ * WPOS on an upscaled target, by a constant [GT6 0112]: as rsx_fp_apply_wpos_scale, but the scale is read from the
+ * pixel constants (fp_wpos.xy = 1 / scale, 1 when the target is not upscaled) instead of being written into the text.
+ * The program's text - and so its compiled shader and its pipeline - is then one for every resolution: changing the
+ * real resolution no longer makes every full-screen pass a new pipeline. Only for the buffered form (the cbuffer that
+ * ends in fp_alpha, which the draw engine follows with fp_wpos); a program without WPOS is left byte-identical.
+ * Returns 1 when inserted, 0 when nothing to do, -1 on a text it cannot place the lines in.
+ */
+int rsx_fp_apply_wpos_scale_cb(char* hlsl, u32 capacity)
+{
+    static const char wpos_read[] = "_rsx_wpos(input.position)";
+    static const char alpha_decl[] = "    float4 fp_alpha;\n";
+    static const char wpos_decl[] = "    float4 fp_wpos;\n";
+    static const char line[] = "    input.position.xy = input.position.xy * fp_wpos.xy;\n";
+    static const char* const entries[] = { "main(PSInput input) : SV_TARGET {\n",
+                                           "main(PSInput input) {\n" };
+    if (!hlsl || !capacity) return -1;
+    size_t len = 0;
+    while (len < capacity && hlsl[len]) ++len;
+    if (len == capacity) return -1;
+    if (!strstr(hlsl, wpos_read)) return 0;
+    if (strstr(hlsl, "input.position.xy = input.position.xy *") || strstr(hlsl, wpos_decl)) return -1;
+    char* decl = strstr(hlsl, alpha_decl);
+    if (!decl) return -1;
+    const size_t nd = sizeof wpos_decl - 1, nl = sizeof line - 1;
+    if (len + nd + nl + 1 > capacity) return -1;
+    decl += sizeof alpha_decl - 1;                       /* the declaration after fp_alpha */
+    memmove(decl + nd, decl, len - (size_t)(decl - hlsl) + 1);
+    memcpy(decl, wpos_decl, nd);
+    len += nd;
+    char* body = NULL;
+    for (size_t i = 0; i < sizeof entries / sizeof entries[0] && !body; ++i) {
+        char* at = strstr(hlsl, entries[i]);
+        if (at) body = at + strlen(entries[i]);
+    }
+    if (!body || body < decl) return -1;
+    memmove(body + nl, body, len - (size_t)(body - hlsl) + 1);
+    memcpy(body, line, nl);
+    return 1;
+}
