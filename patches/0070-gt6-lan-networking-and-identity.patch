+        {
+            char ip[32];
+            unsigned a = 192, b = 168, c = 1, d = 1;
+            if (netctl_get_host_ip(ip, sizeof(ip)) && sscanf(ip, "%u.%u.%u.%u", &a, &b, &c, &d) == 4)
+                snprintf(info->default_route, sizeof(info->default_route), "%u.%u.%u.1", a, b, c);
