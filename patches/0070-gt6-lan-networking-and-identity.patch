+uint32_t sys_net_bnet_inet_ntop(int32_t af, const void* src, char* dst, uint32_t size)
+{
+    if (af != SYS_NET_AF_INET || !src || !dst || size < 16) {
+        fail(af != SYS_NET_AF_INET ? SYS_NET_EAFNOSUPPORT : 28 /* SYS_NET_ENOSPC */);
+        return 0;
+    }
+    const uint8_t* b = GUEST_PTR(EA(src), const uint8_t*);
