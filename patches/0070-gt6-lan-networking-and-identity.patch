 static int netctl_get_host_ip(char* buf, size_t buflen)
 {
+    /* Respect PS3_NET_BIND_IP (e.g. from GT6_LAN_BIND) so multi-NIC PCs report the chosen LAN adapter. */
+    {
+        const char* bind_ip = getenv("PS3_NET_BIND_IP");
+        if (bind_ip && *bind_ip && strcmp(bind_ip, "0.0.0.0") != 0) {
+            unsigned a = 0, b = 0, c = 0, d = 0;
+            if (sscanf(bind_ip, "%u.%u.%u.%u", &a, &b, &c, &d) == 4 && a < 256 && b < 256 && c < 256 && d < 256) {
+                snprintf(buf, buflen, "%u.%u.%u.%u", a, b, c, d);
+                return 1;
+            }
+        }
+    }
