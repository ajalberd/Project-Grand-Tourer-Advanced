+/* [GT6 0119] A SURFACE THAT HOLDS NO COLOUR STANDS FOR NOTHING AT ITS ADDRESS. A draw cannot write its colour target
+ * when no colour target is selected (SET_SURFACE_COLOR_TARGET none) or every channel is masked; the surface that is
+ * bound for such a draw then keeps what it held. Gran Turismo 6 renders its shadow map that way - depth only, colour
+ * target none - and the colour offset register it leaves unused holds 0, the address of display buffer 0. Every such
+ * draw used to mark the 1024x1024 surface made for that pass as drawn, so a surface nothing had ever written colour
+ * to was the newest one at address 0, and what reads that address got its empty pixels instead of the display
+ * buffer's: the game binds a 1x1 texture at offset 0 where a material has no shadow map of its own (the rear-view
+ * mirror lost its sunlight in one frame out of three - the frames in which display buffer 0 was not the one being
+ * drawn - public issue #10), and a draw into display buffer 0 that reads the picture under it got the empty surface
+ * instead of its own target. Now: such a draw or clear does not count as a write, and a surface without any colour
+ * write (draw, clear, copy, blit, upload) is not a candidate for a texture. LD_MASKED_DRAW_STAMP=1 = as before. */
+static int ld_masked_draw_stamp_all(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("LD_MASKED_DRAW_STAMP"); on = e && *e == '1'; }
+    return on;
+}
+static int ld_surface_has_colour(const surface_t* s)
+{
+#if !defined(YZ_PERF_CLEAN)
+    return s->last_draw_generation || s->last_clear_generation || s->last_copy_generation || s->last_blit_generation ||
+           s->last_resolve_generation || s->last_other_generation || ld_masked_draw_stamp_all();
+#else
+    (void)s;
+    return 1;
+#endif
+}
+
